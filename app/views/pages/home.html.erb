<%= javascript_import_module_tag "gsap_client" %>
<%= javascript_import_module_tag "animations" %>

<div class='flex flex-col'>
  <div class="video-container">
    <p class="animated-text" style="--animations: <%= animation_sequence(@animations) %>">
      Testowy tekst do animacji
    </p>
    <%= video_tag "sea-video.mp4", playsinline: true, muted: true %>
  </div>
  <div class="controls">
    <button onclick="play()" class='btn'>Play</button>
    <button onclick="stop()" class='btn'>Stop</button>
    <button onclick="zoomTo('center')">Zoom Center</button>
    <button onclick="zoomTo('top left')">Zoom Top Left</button>
    <button onclick="zoomTo('bottom right')">Zoom Bottom Right</button>
    <button onclick="resetZoom()">Reset</button>
  </div>
</div>


