<div class='bg-base-200 p-3 flex flex-wrap gap-5 justify-between'>
  <div class='flex flex-wrap gap-5'>
    <div class='flex flex-col bg-white p-1'>
      <label for="locale" class='text-base-content/50 text-xs font-semibold'>
        Language
      </label>
      <select name="locale" id="locale" class='pr-10'>
        <option value="en">English (US)</option>
        <option value="pl">Polish</option>
      </select>
    </div>
    
    <div data-controller='toolbar' class='flex bg-white py-1 px-2'>
      <div class='flex flex-col'>
        <label for="locale" class='text-base-content/50 text-xs font-semibold'>
          Seed
        </label>
        <input type="text" data-toolbar-target='output' class='w-30'>
      </div>
      <button data-action='click->toolbar#generateSeed' class='text-xl cursor-pointer px-2'>
        🔃
      </button>
    </div>
    <div class='flex flex-col bg-white p-1 gap-1'>
      <label for="locale" class='text-base-content/50 text-xs font-semibold'>
        Likes
      </label>
      <input type="range" min="0" max="100" value="40" class="range range-primary range-xs" />
    </div>
    <div class='flex flex-col bg-white p-1 w-40'>
      <label for="locale" class='text-base-content/50 text-xs font-semibold'>
        Review
      </label>
      <input type="number" min='0' step='0.1' value='1' class='pr-2'>
    </div>
  </div>

  <div class='flex gap-1 text-white my-auto'>
    <button class='h-8 w-8 p-2 bg-primary btn btn-primary'>
      <%= heroicon 'queue-list', variant: :outline %>
    </button>
    <button class='h-8 w-8 p-2 btn btn-outline btn-primary'>
      <%= heroicon 'square-2-stack', variant: :outline %>
    </button>
  </div>
</div>