<div class='bg-base-200 p-3 flex flex-wrap gap-5 justify-between'>
  <div class='flex flex-wrap gap-5'>
    <div class='flex flex-col bg-base-100 p-1'>
      <label for="locale" class='text-base-content/50 text-xs font-semibold'>
        Language
      </label>
      <select name="locale" id="locale" class='pr-10'>
        <option value="en">English (US)</option>
        <option value="pl">Polish</option>
      </select>
    </div>
    
    <div class='flex bg-base-100 py-1 px-2'>
      <%= form_with url: root_path, method: :get, class: 'flex bg-base-100 py-1 px-2' do %>
        <div class='flex flex-col'>
          <label for="locale" class='text-base-content/50 text-xs font-semibold'>
            Seed
          </label>
          <input type="text" name="seed" value='<%= @seed %>' class='w-30'>
        </div>
      <% end %>
      <%= button_to '🔃', root_path, method: :get, class: 'text-xl cursor-pointer px-2', form_class: 'flex align-center' %>
    </div>
    <div class='flex flex-col bg-base-100 p-1 gap-1'>
      <label for="locale" class='text-base-content/50 text-xs font-semibold'>
        Likes
      </label>
      <%= form_with url: root_path, method: :get, data: { turbo_stream: true } do %>
        <input type="range" name="likes" min="0" max="10" step='0.1'
               value="<%= params[:likes] || @DEFAULT_LIKES %>"
               autocomplete="off"
               onchange="this.form.requestSubmit()"
               class="range range-primary range-xs" />
      <% end %>
    </div>
    <div class='flex flex-col bg-base-100 p-1 w-43'>
      <label for="locale" class='text-base-content/50 text-xs font-semibold'>
        Review
      </label>
      <%= form_with url: root_path, method: :get, data: { turbo_stream: true } do %>
        <input type="number" name="reviews" min='0' step='0.1'
               value="<%= params[:reviews] || @DEFAULT_REVIEWS %>"
               autocomplete="off"
               onchange="this.form.requestSubmit()"
               class='pr-2 w-40'>
      <% end %>
    </div>
  </div>

  <div class='flex gap-1 text-white my-auto'>
    <button class='h-8 w-8 p-2 bg-primary btn btn-primary'>
      <%= heroicon 'queue-list', variant: :outline %>
    </button>
    <button class='h-8 w-8 p-2 btn btn-outline btn-primary'>
      <%= heroicon 'square-2-stack', variant: :outline %>
    </button>
  </div>
</div>