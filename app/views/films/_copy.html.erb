<% copy = @copy[id.to_i - 1] %>
<div class='text-base-content/75 flex flex-col gap-1'>
  <div class='flex gap-5 items-baseline'>
    <h1 class='text-base-content text-lg'>
      <%= copy[:title] %>
    </h1>
    <h2 class='text-md'>
      <%= copy[:year] %>, <%= copy[:genre] %>
    </h2>
    <div class='badge badge-soft badge-info text-xs font-bold'>
    <%= copy[:likes] %>
    <span class='size-4'><%= heroicon('hand-thumb-up')%></span>
  </div>
  </div>

  <div class='flex gap-2 items-baseline'>
    <div class="badge badge-primary text-xs font-bold"><%= copy[:tag] %></div>
    <p class='text-base-content/50 text-xs'><%= copy[:length] %> min</p>
    <p class='text-base-content font-bold text-sm'><%= copy[:age] %>+</p>
  </div>
  

  <div class='flex flex-col gap-1'>
    <p class='font-bold text-xs'>
      Cast: 
      <span class='italic font-semibold'>
        <%= copy[:cast].join(', ') %>
      </span>
    </p>
    
    <p class='font-bold text-xs'>
      Director: 
      <span class='italic font-semibold'>
        <%= copy[:director] %>
      </span>
    </p>

    <p class='font-bold text-xs'>
      Description:
    </p>
    <p class='text-xs'>
      <%= copy[:description] %>
    </p>

    <p class='font-bold text-xs'>
      Reviews: 
    </p>
    <div class='flex flex-col gap-2'>
      <% copy[:reviews].each do |review| %>
        <div>
          <p class='text-xs'><%= review[:review] %></p>
          <p class='font-light text-[10px]'>
            - <%= review[:author] %>, <%= review[:company] %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>