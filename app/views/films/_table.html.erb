<div class="overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th></th>
        <th>#</th>
        <th>Genre</th>
        <th>Title</th>
        <th>Cast</th>
        <th>Year</th>
      </tr>
    </thead>

    <tbody>
        <tr onclick="toggleRow('row-1')" class='cursor-pointer'>
          <td><span id='icon-row-1' class="inline-block transition-transform">▶</span></td>
          <th>1</th>
          <td><%= @copy[0][:genre] %></td>
          <td><%= @copy[0][:title] %></td>
          <td><%= @copy[0][:cast].join(', ') %></td>
          <td><%= @copy[0][:year] %></td>
        </tr>
        <tr id="row-1" class='hidden'>
          <td colspan="6">
            <div class="p-4 flex gap-3">
              <%= render 'films/player', id: '1' %>
              <%= render 'films/copy', id: '1' %>
            </div>
          </td>
        </tr>
      </div>

      <tr onclick="toggleRow('row-2')" class='cursor-pointer'>
        <td><span id='icon-row-2' class="inline-block transition-transform">▶</span></td>
        <th>2</th>
        <td><%= @copy[1][:genre] %></td>
        <td><%= @copy[1][:title] %></td>
        <td><%= @copy[1][:cast].join(', ') %></td>
        <td><%= @copy[1][:year] %></td>
      </tr>
      <tr id="row-2" class='hidden'>
          <td colspan="6">
            <div class="p-4 flex gap-3">
              <%= render 'films/player', id: '2' %>
              <%= render 'films/copy', id: '2' %>
            </div>
          </td>
        </tr>
    </tbody>
  </table>
</div>