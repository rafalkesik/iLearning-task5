<%= javascript_import_module_tag "animations" %>

<% sequence = animation_sequence(@animations) %>

<div class='flex flex-col'>
  <div class="video-container">
    <% @texts.each_with_index do |text, i| %>
      <p class="animated-text video-<%= id %>-text" style="--animations: <%= sequence[i] %>">
        <%= text %>
      </p>
    <% end %>
    <%= video_tag "sea-video.mp4", playsinline: true, muted: true, class: "video-#{id}" %>
  </div>
  <div class="w-[250px] mt-1 flex flex-col gap-2">
    <div class='flex flex-1 gap-3'>
      <button onclick="play(<%= id %>)" class='btn btn-primary flex-1'>Play</button>
      <button onclick="stop(<%= id %>)" class='btn btn-primary flex-1'>Stop</button>
    </div>
    <button onclick="zoomTo(<%= id %>, 'center')" class='btn'>Zoom Center</button>
    <button onclick="zoomTo(<%= id %>, 'top left')" class='btn'>Zoom Top Left</button>
    <button onclick="zoomTo(<%= id %>, 'bottom right')" class='btn'>Zoom Bottom Right</button>
    <button onclick="resetZoom(<%= id %>)" class='btn'>Reset</button>
  </div>
</div>