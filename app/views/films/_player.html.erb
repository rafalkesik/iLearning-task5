<%= javascript_import_module_tag "animations" %>

<% sequence = animation_sequence(@animations) %>

<div class='flex flex-col'>
  <div class="video-container">
    <% @texts.each_with_index do |text, i| %>
      <p id="video-0-text-<%= i %>" class="animated-text" style="--animations: <%= sequence[i] %>">
        <%= text %>
      </p>
    <% end %>
    <%= video_tag "sea-video.mp4", playsinline: true, muted: true %>
  </div>
  <div class="controls">
    <button onclick="play()" class='btn btn-primary'>Play</button>
    <button onclick="stop()" class='btn btn-primary'>Stop</button>
    <button onclick="zoomTo('center')" class='btn'>Zoom Center</button>
    <button onclick="zoomTo('top left')" class='btn'>Zoom Top Left</button>
    <button onclick="zoomTo('bottom right')" class='btn'>Zoom Bottom Right</button>
    <button onclick="resetZoom()" class='btn'>Reset</button>
  </div>
</div>